# StoryNex AI Environment Variables (Optional)
# If provided, these will be used as defaults for all users.
# Users can also input their own API key via the in-app Settings modal.

# Groq API Key (from https://console.groq.com/keys)
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Default Groq Model (Optional - defaults to llama-3.3-70b-versatile)
VITE_GROQ_MODEL=llama-3.3-70b-versatile
